                  "text",
                  "video"
                ]
              }
            },
            "required": [
              "provider",
              "model_name",
              "workload"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "review_date",
        "mapping_basis",
