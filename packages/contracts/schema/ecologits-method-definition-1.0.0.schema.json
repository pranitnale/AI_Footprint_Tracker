            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "model_name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,191}$"
              },
              "workload": {
                "type": "string",
