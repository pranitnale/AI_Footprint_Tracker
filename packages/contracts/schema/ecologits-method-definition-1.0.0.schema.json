                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,9})?$"
                      },
                      "max": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,9})?$"
                      }
                    },
                    "required": [
                      "min",
                      "max"
