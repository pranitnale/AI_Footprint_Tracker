            {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "const": "original_engine"
                }
              },
              "required": [
                "strategy"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "const": "unavailable"
                }
              },
              "required": [
                "strategy"
              ],
              "additionalProperties": false
