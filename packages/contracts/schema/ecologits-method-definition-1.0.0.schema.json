    "engine_id": {
      "type": "string",
      "const": "ecologits"
    },
    "core": {
      "type": "object",
      "properties": {
        "catalog_schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
        },
        "catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "converter_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
        },
        "core_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "core_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
        },
        "requested_git_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "upstream_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
        }
