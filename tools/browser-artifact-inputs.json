{
  "schema_version": "1.0.0",
  "variant_schema_version": "1.0.0",
  "path_order": "utf8_bytes",
  "engines": ["ecologits"],
  "fixed_files": [
    ".node-version",
    "BROWSER-SOURCE-README.md",
    "LICENSE",
    "SBOM.cdx.json",
    "THIRD-PARTY-INVENTORY.json",
    "THIRD-PARTY-NOTICES.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tools/browser-artifact-inputs.json",
    "tsconfig.base.json"
  ],
  "source_roots": ["apps/extension", "packages", "config", "tools"],
  "excluded_parts": [
    ".git",
    ".output",
    ".pytest_cache",
    ".ruff_cache",
    ".test-runtime",
    ".venv",
    ".wxt",
    "__pycache__",
    "artifacts",
    "cassettes",
    "coverage",
    "dist",
    "images",
    "node_modules",
    "output",
    "private",
    "screenshots"
  ],
  "excluded_suffixes": [".db", ".log", ".pyc", ".sqlite", ".sqlite3"],
  "provider_matches": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://notebook.google.com/*"
  ],
  "required_source_entries": [
    "BROWSER-SOURCE-README.md",
    "LICENSE",
    "SBOM.cdx.json",
    "THIRD-PARTY-INVENTORY.json",
    "apps/extension/entrypoints/file-relay.html",
    "apps/extension/lib/file-association-protocol.ts",
    "apps/extension/lib/file-grant-broker.ts",
    "apps/extension/lib/file-offer-bridge.ts",
    "apps/extension/lib/file-relay-protocol.ts",
    "apps/extension/lib/file-relay.ts",
    "apps/extension/lib/counting-config.ts",
    "apps/extension/lib/dashboard/use-monthly-summary.ts",
    "apps/extension/lib/monthly-summary.ts",
    "apps/extension/lib/runtime-composition.ts",
    "apps/extension/lib/upload-correlation.ts",
    "apps/extension/lib/upload-observer.ts",
    "apps/extension/package.json",
    "apps/extension/build/notices.ts",
    "apps/extension/build/release-metadata.ts",
    "apps/extension/build/variant.ts",
    "apps/extension/lib/estimation/config.ts",
    "apps/extension/wxt.config.ts",
    "config/estimation.build.json",
    "config/estimation.mappings.json",
    "packages/ecologits-core/CITATION.cff",
    "packages/ecologits-core/LICENSE",
    "packages/ecologits-core/NOTICE.md",
    "packages/ecologits-core/data/catalog.json",
    "packages/ecologits-core/data/identity.json",
    "packages/ecologits-core/oracle/pyproject.toml",
    "packages/ecologits-core/oracle/uv.lock",
    "packages/ecologits-core/source-to-port-map.json",
    "packages/ecologits-core/src/index.ts",
    "packages/ecologits-core/upstream/lock.json",
    "packages/ecologits-core/upstream/retained-source.json",
    "packages/file-text/src/index.ts",
    "packages/file-text/src/types.ts",
    "packages/ledger/src/indexeddb-repository.ts",
    "packages/ledger/src/memory-repository.ts",
    "packages/ledger/src/monthly-claim.ts",
    "packages/ledger/src/repository-contracts.ts",
    "packages/ledger/src/session-contracts.ts",
    "package.json",
    "pnpm-lock.yaml",
    "tools/browser-artifact-inputs.json",
    "tools/package-browser-artifacts.py",
    "tools/refinement/build-variants.ts",
    "packages/tokenizers/src/runtime.ts",
    "tools/verify-source-archive.py"
  ],
  "required_variant_entries": [
    "build-variant.json",
    "licenses.html",
    "licenses/ecologits/MPL-2.0.txt",
    "licenses/ecologits/NOTICE.md",
    "licenses/ecologits/CITATION.cff",
    "licenses/inventory.json",
    "source/ecologits-source.zip"
  ],
  "web_accessible_resources": ["file-relay.html", "methodology-reference.html"],
  "targets": {
    "chrome": {
      "folder": "chrome-mv3",
      "manifest_version": 3,
      "target": "chrome-mv3"
    },
    "edge": {
      "folder": "edge-mv3",
      "manifest_version": 3,
      "target": "edge-mv3"
    },
    "firefox": {
      "folder": "firefox-mv2",
      "manifest_version": 2,
      "target": "firefox-mv2"
    }
  }
}
