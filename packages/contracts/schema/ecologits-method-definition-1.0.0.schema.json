        },
        "mapping_basis": {
          "type": "string",
          "const": "consumer_to_api_assumption"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
