# Copy to a protected deployment-only environment file. Values below are examples.
AIFT_POSTGRES_DB=aift
AIFT_POSTGRES_USER=aift
AIFT_POSTGRES_PASSWORD_FILE=/srv/aift/secrets/postgres-password
AIFT_SETTINGS_FILE=/srv/aift/secrets/settings.json
AIFT_JOURNAL_DIRECTORY=/srv/aift/deletion-journal
AIFT_TLS_DIRECTORY=/srv/aift/tls
AIFT_REGISTRATION_HOST=footprint.example.org
# The self-hosted organization's own domain or subdomain, the host of self_host_origin. It must
# differ from the registration and operator hosts. Leave it empty only for the hosted service, which
# serves every organization at the registration host.
AIFT_TENANT_HOST=company.footprint.example.org
AIFT_OPERATOR_HOST=operator.footprint.example.org
AIFT_HTTPS_BIND=0.0.0.0:443
