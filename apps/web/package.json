{
  "name": "@footprint/web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-methodology.mjs && node scripts/prepare-downloads.mjs --force-unavailable && vite",
    "build": "node scripts/build-methodology.mjs && node scripts/prepare-downloads.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-methodology.mjs && node scripts/prepare-downloads.mjs --force-unavailable && tsx --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "@footprint/contracts": "workspace:*",
    "@footprint/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/jsdom": "30.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "29.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
